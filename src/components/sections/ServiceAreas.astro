---
import Button from '../ui/Button.astro';

const areas = [
  {
    name: 'Brisbane Southside',
    desc: 'From Sunnybank & Mt Gravatt out to Jimboomba & Greenbank acreages.',
    tag: 'Daily Dispatch',
  },
  {
    name: 'Brisbane CBD & Northside',
    desc: 'Inner-city suburbs up through Chermside, Bridgeman Downs & Samford Valley.',
    tag: 'Daily Dispatch',
  },
  {
    name: 'Logan',
    desc: 'Springwood, Browns Plains, Logan Village, Yarrabilba and surrounding districts.',
    tag: 'Rapid Response',
  },
  {
    name: 'Ipswich',
    desc: 'Ipswich central, Springfield, Ripley Valley, Karalee, Rosewood & Amberley.',
    tag: 'Acreage & Residential',
  },
  {
    name: 'Redland Bay',
    desc: 'Cleveland, Victoria Point, Capalaba, Alexandra Hills & coastal island links.',
    tag: 'Bayside Coverage',
  },
  {
    name: 'Moreton Bay',
    desc: 'North Lakes, Caboolture, Dayboro, Woodford, Bribie Island & Redcliffe.',
    tag: 'Semi-Rural Experts',
  },
  {
    name: 'Gold Coast',
    desc: 'Northern Gold Coast through Ormeau, Coomera, Tamborine Mountain & Hinterland.',
    tag: 'Hinterland & Coast',
  },
  {
    name: 'Sunshine Coast',
    desc: 'Caloundra, Maroochydore, Glass House Mountains, Maleny & Hinterland.',
    tag: 'Regional Dispatch',
  },
];
---

<section class="section section-alt areas-section" id="service-areas">
  <div class="container">
    <div class="section-header">
      <div class="section-eyebrow">
        <span>GREATER BRISBANE & SE QLD</span>
      </div>
      <h2 class="section-title">
        Service <span class="text-gradient-cyan">Areas</span>
      </h2>
      <p class="section-subtitle">
        We install and configure Starlink systems across Greater Brisbane and surrounding South East Queensland regions:
      </p>
    </div>

    <!-- 8 Area Cards Grid -->
    <div class="areas-grid">
      {areas.map((area) => (
        <div class="glass-card area-card">
          <div class="area-card-header">
            <div class="area-icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="area-tag">{area.tag}</span>
          </div>

          <h3 class="area-name">{area.name}</h3>
          <p class="area-desc">{area.desc}</p>
        </div>
      ))}
    </div>

    <!-- Not Sure Callout -->
    <div class="areas-cta-box">
      <div class="areas-cta-left">
        <span class="pulse-ring">📍</span>
        <div>
          <h4 class="areas-cta-title">Not Sure If We Cover Your Exact Address?</h4>
          <p class="areas-cta-sub">
            Call <strong><a href="tel:0477319160">0477 319 160</a></strong> — we dispatch technicians widely across South East Queensland and regional hinterlands.
          </p>
        </div>
      </div>
      <Button href="tel:0477319160" variant="phone" size="md">
        <span>Check Coverage: 0477 319 160</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .areas-section {
    position: relative;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .areas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .areas-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .area-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem;
  }

  .area-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .area-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    color: var(--starlink-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .area-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0369a1;
  }

  .area-name {
    font-size: 1.125rem;
    color: var(--text-heading);
    line-height: 1.25;
  }

  .area-desc {
    font-size: 0.8125rem;
    color: var(--text-body);
    line-height: 1.45;
    margin: 0;
  }

  /* Areas CTA Box */
  .areas-cta-box {
    background: #ffffff;
    border: 1px solid var(--border-medium);
    border-radius: 1rem;
    padding: 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 860px) {
    .areas-cta-box {
      flex-direction: row;
      align-items: center;
    }
  }

  .areas-cta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pulse-ring {
    font-size: 1.75rem;
  }

  .areas-cta-title {
    font-size: 1.05rem;
    color: var(--text-heading);
    margin-bottom: 0.15rem;
  }

  .areas-cta-sub {
    font-size: 0.875rem;
    color: var(--text-body);
    margin: 0;
  }

  .areas-cta-sub strong a {
    color: var(--starlink-cyan);
    font-weight: 700;
  }
</style>
