---
import Button from '../ui/Button.astro';
---

<section class="section cta-banner-section" id="cta-contact">
  <div class="container">
    <div class="cta-banner-card">
      <div class="cta-bg-glow" aria-hidden="true"></div>

      <div class="cta-inner-grid">
        <div class="cta-content">
          <span class="cta-eyebrow">FAST QUEENSLAND DISPATCH</span>
          <h2 class="cta-title">Ready for Fast Internet <span class="text-gradient-cyan">Anywhere?</span></h2>
          <p class="cta-desc">
            Call Zoo Computer Repairs on <strong>0477 319 160</strong> or get in touch online for your Starlink installation quote. We come to you across Greater Brisbane and South East Queensland.
          </p>

          <div class="cta-perks">
            <span class="perk-item">✓ Upfront Phone Quotes</span>
            <span class="perk-item">✓ Storm-Proof Mounting</span>
            <span class="perk-item">✓ Whole-Home WiFi Setup</span>
          </div>
        </div>

        <div class="cta-actions-col">
          <Button href="tel:0477319160" variant="primary" size="lg" class="cta-btn-main">
            <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span>Call 0477 319 160</span>
          </Button>

          <Button href="#quote-form" variant="outline" size="lg" class="cta-btn-alt">
            <span>Get a Free Quote Online</span>
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner-section {
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    position: relative;
  }

  .cta-banner-card {
    background: #ffffff;
    border: 1px solid var(--border-medium);
    border-radius: 1.5rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .cta-bg-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, rgba(37, 99, 235, 0.02) 60%, transparent 80%);
    pointer-events: none;
  }

  .cta-inner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 960px) {
    .cta-inner-grid {
      grid-template-columns: 1.3fr 0.9fr;
      gap: 3rem;
    }

    .cta-actions-col {
      justify-self: end;
      width: 100%;
      max-width: 280px;
    }
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cta-eyebrow {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--action-orange);
  }

  .cta-title {
    font-size: clamp(1.85rem, 3vw + 0.5rem, 2.75rem);
    color: var(--text-heading);
    line-height: 1.15;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--text-body);
    line-height: 1.6;
    margin: 0;
  }

  .cta-desc strong {
    color: var(--starlink-cyan);
  }

  .cta-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .perk-item {
    font-size: 0.875rem;
    color: #334155;
    font-weight: 600;
  }

  .cta-actions-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cta-btn-main {
    width: 100%;
    justify-content: center;
    background: #2563eb;
    color: #ffffff;
    border-color: #1d4ed8;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .cta-btn-main:hover {
    background: #1d4ed8;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(29, 78, 216, 0.35);
  }

  .cta-btn-alt {
    width: 100%;
    justify-content: center;
    background: #ffffff;
    color: var(--text-heading);
    border: 1px solid var(--border-medium);
    box-shadow: none;
  }

  .cta-btn-alt:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: var(--text-heading);
  }
</style>
