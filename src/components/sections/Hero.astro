---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import QuoteForm from '../ui/QuoteForm.astro';

const capabilities = [
  'Site Survey & Obstruction Check',
  'Roof & Wall Dish Mounting',
  'Clean Weatherproof Cable Routing',
  'Router & WiFi Network Setup',
  'Ethernet & Network Integration',
];
---

<section class="hero-section" id="hero">
  <!-- Dynamic Space Glow Decor -->
  <div class="hero-bg-glow" aria-hidden="true"></div>
  <div class="hero-grid-pattern" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy & Trust Signals -->
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <Badge variant="cyan" dot={true}>
            STARLINK INSTALLATION SPECIALISTS
          </Badge>
          <span class="geo-badge">
            <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            Greater Brisbane & SE QLD
          </span>
        </div>

        <h1 class="hero-title">
          Starlink Installation <span class="text-gradient-cyan">Brisbane</span>
        </h1>

        <p class="hero-lead">
          Professional dish mounting, cable routing, router setup and whole-home WiFi coverage across Brisbane. We’re IT technicians, not just antenna installers, so the job doesn’t stop when the dish is on the roof. We completely optimise it for your whole home / office / extended property. Others will say It’s out of their Hands after they install the equipment. We offer a complete solution.
        </p>

        <!-- Capabilities Checklist -->
        <div class="capabilities-box">
          <p class="capabilities-title">Every standard installation includes:</p>
          <ul class="capabilities-list">
            {capabilities.map((item) => (
              <li class="capability-item">
                <span class="check-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Hero Actions -->
        <div class="hero-actions">
          <Button href="tel:0477319160" variant="primary" size="lg">
            <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <span>Call 0477 319 160</span>
          </Button>

          <Button href="#quote-form" variant="outline" size="lg">
            <span>Get a Free Quote</span>
            <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </Button>
        </div>

        <!-- Micro Trust Signals -->
        <div class="hero-trust-row">
          <div class="trust-pill">
            <span class="trust-icon">⚡</span>
            <span>100+ Mbps Speed Testing</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon">⛈️</span>
            <span>Storm-Proof Mounts</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon">🛡️</span>
            <span>No Dangling Cables</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Quote Form -->
      <div class="hero-form-col">
        <QuoteForm id="hero-quote-form" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  .hero-bg-glow {
    position: absolute;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 600px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, rgba(37, 99, 235, 0.02) 50%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(15, 23, 42, 0.03) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(15, 23, 42, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  /* Left Col */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-badge-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .geo-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-body);
    background: #f1f5f9;
    border: 1px solid var(--border-subtle);
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
  }

  .geo-badge svg {
    color: var(--starlink-cyan);
  }

  .hero-title {
    font-size: clamp(2.25rem, 4vw + 1rem, 3.65rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--text-heading);
  }

  .hero-lead {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: var(--text-body);
    line-height: 1.65;
  }

  /* Capabilities */
  .capabilities-box {
    background: #f8fafc;
    border: 1px solid var(--border-subtle);
    border-radius: 0.875rem;
    padding: 1.1rem 1.25rem;
  }

  .capabilities-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--starlink-cyan-light);
    margin-bottom: 0.6rem;
  }

  .capabilities-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 600px) {
    .capabilities-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capability-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #1e293b;
    font-weight: 500;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--starlink-cyan);
    flex-shrink: 0;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  /* Trust Row */
  .hero-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .trust-icon {
    font-size: 1rem;
  }

  /* Right Col Form */
  .hero-form-col {
    width: 100%;
  }
</style>
