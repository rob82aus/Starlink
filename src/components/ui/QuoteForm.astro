---
interface Props {
  id?: string;
  compact?: boolean;
}

const { id = 'quote-form', compact = false } = Astro.props;
---

<div class={`quote-form-card ${compact ? 'is-compact' : ''}`} id={id}>
  <div class="form-header">
    <div class="form-badge">Fast Response</div>
    <h3 class="form-title">Get a Free Starlink Quote</h3>
    <p class="form-desc">Direct quote over the phone before booking. No hidden fees.</p>
  </div>

  <form class="lead-form" id="starlink-lead-form" novalidate>
    <!-- SplitForms Access Key & Metadata -->
    <input type="hidden" name="access_key" value="1d66ead806e3439ea5d8caeab9092c18" />
    <input type="hidden" name="subject" value="New Starlink Installation Quote Request" />

    <!-- SplitForms Honeypot -->
    <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" style="display: none;" />

    <!-- Local Spam Trap Honeypot -->
    <div class="sr-only" aria-hidden="true">
      <label for="form-website-trap">Leave this field blank</label>
      <input type="text" id="form-website-trap" name="website_url" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Service Selection -->
    <div class="form-group">
      <label for="service-select" class="form-label">
        Service Required <span class="required" aria-hidden="true">*</span>
      </label>
      <div class="select-wrapper">
        <select id="service-select" name="service" class="form-input" required>
          <option value="Starlink Installation" selected>Starlink Installation (Standard / High-Performance)</option>
          <option value="Whole-Home Mesh WiFi Setup">Whole-Home Mesh WiFi & Network Integration</option>
          <option value="Starlink Relocation or Dish Repositioning">Starlink Relocation & Troubleshooting</option>
          <option value="Business & Commercial Network Integration">Business & Commercial Starlink Setup</option>
          <option value="TV Wall Mounting">TV Wall Mounting</option>
          <option value="TV Antenna Installation">TV Antenna Installation</option>
          <option value="Not sure – need a diagnosis">Not sure – Need Advice / Diagnosis</option>
        </select>
        <svg class="select-arrow" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </div>
      <span class="field-error" id="service-error" role="alert"></span>
    </div>

    <!-- Two Column: Name & Phone -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="form-name" class="form-label">
          Full Name <span class="required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="form-name"
          name="name"
          class="form-input"
          placeholder="e.g. David Miller"
          required
          autocomplete="name"
        />
        <span class="field-error" id="name-error" role="alert"></span>
      </div>

      <div class="form-group">
        <label for="form-phone" class="form-label">
          Phone Number <span class="required" aria-hidden="true">*</span>
        </label>
        <input
          type="tel"
          id="form-phone"
          name="phone"
          class="form-input"
          placeholder="e.g. 0477 319 160"
          required
          autocomplete="tel"
        />
        <span class="field-error" id="phone-error" role="alert"></span>
      </div>
    </div>

    <!-- Two Column: Email & Suburb -->
    <div class="form-grid-2">
      <div class="form-group">
        <label for="form-email" class="form-label">
          Email Address <span class="optional">(Optional)</span>
        </label>
        <input
          type="email"
          id="form-email"
          name="email"
          class="form-input"
          placeholder="e.g. name@example.com.au"
          autocomplete="email"
        />
        <span class="field-error" id="email-error" role="alert"></span>
      </div>

      <div class="form-group">
        <label for="form-suburb" class="form-label">
          Brisbane / QLD Suburb <span class="required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="form-suburb"
          name="suburb"
          class="form-input"
          placeholder="e.g. Samford, Logan, Redland"
          required
          autocomplete="address-level2"
        />
        <span class="field-error" id="suburb-error" role="alert"></span>
      </div>
    </div>

    <!-- Message Field -->
    <div class="form-group">
      <label for="form-message" class="form-label">
        Job Details / Roof Type <span class="required" aria-hidden="true">*</span>
      </label>
      <textarea
        id="form-message"
        name="message"
        class="form-textarea"
        rows="3"
        placeholder="Tell us about your property (single/two-storey, roof type, kit version or WiFi goals)..."
        required
      ></textarea>
      <span class="field-error" id="message-error" role="alert"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="submit-btn" id="form-submit-btn">
      <span class="btn-text">Request Free Quote Now</span>
      <span class="btn-spinner" aria-hidden="true"></span>
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </button>

    <!-- Form Notification States -->
    <div class="form-alert form-success" id="form-success-alert" role="status" aria-live="polite" style="display: none;">
      <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <div>
        <strong>Quote Request Received!</strong>
        <p>Thank you! Our technician will call you shortly at the provided number to confirm details and give you an upfront quote.</p>
      </div>
    </div>

    <div class="form-alert form-error" id="form-general-error" role="alert" style="display: none;">
      <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <div>
        <strong>Please check required fields</strong>
        <p id="form-error-text">Please complete all required fields with valid details.</p>
      </div>
    </div>

    <div class="form-footer-note">
      <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
      </svg>
      <span>No obligation quote. Your details are strictly confidential.</span>
    </div>
  </form>
</div>

<style>
  .quote-form-card {
    background: #ffffff;
    border: 1px solid var(--border-medium);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }

  .quote-form-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #0284c7 0%, var(--action-orange) 50%, var(--starlink-blue) 100%);
  }

  .form-header {
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .form-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #c2410c;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .form-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: var(--text-heading);
    margin-bottom: 0.35rem;
  }

  .form-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  @media (min-width: 520px) {
    .form-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    position: relative;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .required {
    color: #ef4444;
  }

  .optional {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 400;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text-heading);
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    padding: 0.75rem 0.95rem;
    transition: all var(--transition-fast);
    outline: none;
  }

  .form-input:hover,
  .form-textarea:hover {
    border-color: #94a3b8;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--starlink-cyan);
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    background: #ffffff;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--text-dim);
  }

  .form-input.is-invalid,
  .form-textarea.is-invalid {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
  }

  .select-wrapper {
    position: relative;
  }

  .select-wrapper select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.25rem;
    cursor: pointer;
  }

  .select-arrow {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .field-error {
    font-size: 0.75rem;
    color: #dc2626;
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  /* Submit Button */
  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    background: #2563eb;
    border: 1px solid #1d4ed8;
    border-radius: 0.625rem;
    padding: 0.9rem 1.5rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    margin-top: 0.5rem;
  }

  .submit-btn:hover:not(:disabled) {
    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(29, 78, 216, 0.35);
  }

  .submit-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  .btn-spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .submit-btn.loading .btn-text {
    opacity: 0.9;
  }

  .submit-btn.loading .btn-spinner {
    display: block;
  }

  .submit-btn.loading .btn-icon {
    display: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Alerts */
  .form-alert {
    padding: 0.85rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .form-success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #166534;
  }

  .form-success p {
    margin-top: 0.25rem;
    color: #15803d;
  }

  .form-error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
  }

  .form-error p {
    margin-top: 0.25rem;
    color: #b91c1c;
  }

  .form-footer-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
  }

  .form-footer-note svg {
    color: var(--starlink-cyan);
    flex-shrink: 0;
  }
</style>

<script>
  // Client-side quote form handler
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('starlink-lead-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;
    const successAlert = document.getElementById('form-success-alert');
    const generalError = document.getElementById('form-general-error');
    const errorText = document.getElementById('form-error-text');

    const fields = {
      name: document.getElementById('form-name') as HTMLInputElement,
      phone: document.getElementById('form-phone') as HTMLInputElement,
      email: document.getElementById('form-email') as HTMLInputElement,
      suburb: document.getElementById('form-suburb') as HTMLInputElement,
      message: document.getElementById('form-message') as HTMLTextAreaElement,
      website: document.getElementById('form-website-trap') as HTMLInputElement,
    };

    const validatePhone = (phone: string) => {
      // Allow Australian mobile (04xx xxx xxx) or landline or standard digits (min 8 digits)
      const clean = phone.replace(/[\s\-\(\)\+]/g, '');
      return clean.length >= 8 && /^\d+$/.test(clean);
    };

    const validateEmail = (email: string) => {
      if (!email.trim()) return true; // Optional field
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    };

    const showError = (input: HTMLElement | null, errorElId: string, msg: string) => {
      if (input) input.classList.add('is-invalid');
      const errEl = document.getElementById(errorElId);
      if (errEl) {
        errEl.textContent = msg;
        errEl.classList.add('visible');
      }
    };

    const clearError = (input: HTMLElement | null, errorElId: string) => {
      if (input) input.classList.remove('is-invalid');
      const errEl = document.getElementById(errorElId);
      if (errEl) {
        errEl.textContent = '';
        errEl.classList.remove('visible');
      }
    };

    // Live validation clearing on input
    Object.entries(fields).forEach(([key, input]) => {
      if (!input) return;
      input.addEventListener('input', () => {
        clearError(input, `${key}-error`);
        if (generalError) generalError.style.display = 'none';
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Prevent duplicate submissions while a request is in progress
      if (submitBtn?.classList.contains('loading') || submitBtn?.disabled) {
        return;
      }

      // Check SplitForms botcheck honeypot
      const botcheck = form.querySelector('input[name="botcheck"]') as HTMLInputElement | null;
      if (botcheck && botcheck.checked) {
        return;
      }

      // Check local spam trap honeypot
      if (fields.website && fields.website.value.trim() !== '') {
        return;
      }

      let isValid = true;

      // Validate Name
      if (!fields.name.value.trim()) {
        showError(fields.name, 'name-error', 'Please enter your full name.');
        isValid = false;
      } else {
        clearError(fields.name, 'name-error');
      }

      // Validate Phone
      if (!fields.phone.value.trim()) {
        showError(fields.phone, 'phone-error', 'Please enter your phone number.');
        isValid = false;
      } else if (!validatePhone(fields.phone.value)) {
        showError(fields.phone, 'phone-error', 'Please enter a valid phone number (at least 8-10 digits).');
        isValid = false;
      } else {
        clearError(fields.phone, 'phone-error');
      }

      // Validate Email (optional)
      if (fields.email.value.trim() && !validateEmail(fields.email.value)) {
        showError(fields.email, 'email-error', 'Please enter a valid email address.');
        isValid = false;
      } else {
        clearError(fields.email, 'email-error');
      }

      // Validate Suburb
      if (!fields.suburb.value.trim()) {
        showError(fields.suburb, 'suburb-error', 'Please enter your suburb (e.g. Brisbane Southside, Samford).');
        isValid = false;
      } else {
        clearError(fields.suburb, 'suburb-error');
      }

      // Validate Message
      if (!fields.message.value.trim()) {
        showError(fields.message, 'message-error', 'Please provide a brief description of your installation.');
        isValid = false;
      } else {
        clearError(fields.message, 'message-error');
      }

      if (!isValid) {
        if (generalError) {
          generalError.style.display = 'flex';
          if (errorText) errorText.textContent = 'Please correct the highlighted fields above.';
        }
        return;
      }

      // UI Loading state
      if (submitBtn) {
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;
      }
      if (generalError) generalError.style.display = 'none';

      try {
        const formData = new FormData(form);

        const response = await fetch('https://splitforms.com/api/submit', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json',
          },
        });

        const result = await response.json().catch(() => null);

        // Require an explicit, positive confirmation signal from the endpoint JSON payload.
        // Malformed JSON, empty responses, and unconfirmed responses must never trigger success or form reset.
        const isConfirmedSuccess = response.ok && Boolean(
          result &&
          (result.success === true || result.success === 'true' || result.status === 'success' || result.ok === true)
        );

        if (isConfirmedSuccess) {
          // Form success state - only reset and display confirmation after verified server confirmation
          if (successAlert) successAlert.style.display = 'flex';
          form.reset();
          successAlert?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          const errorMsg = result?.message || result?.error || 'Unconfirmed response from submission endpoint';
          throw new Error(errorMsg);
        }
      } catch (err) {
        // On failure, preserve all customer entered data and show clear error with phone fallback
        if (generalError) {
          generalError.style.display = 'flex';
          if (errorText) {
            errorText.textContent = 'Unable to submit your quote request right now. Please call us directly on 0477 319 160.';
          }
          generalError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } finally {
        if (submitBtn) {
          submitBtn.classList.remove('loading');
          submitBtn.disabled = false;
        }
      }
    });
  });
</script>
